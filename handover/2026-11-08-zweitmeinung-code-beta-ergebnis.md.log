    72	def gespraech_fuehren(nummer, fragen, anweisung, lauf):
    73	    arbeit = DATEN / "gespraeche" / f"{lauf}-{nummer:02d}"
    74	    arbeit.mkdir(parents=True)
    75	    shutil.chown(arbeit, "dwhv3", "dwhv3")
    76	    ergebnis = {"nummer": nummer, "runden": []}
    77	    try:
    78	        with Gespraech(arbeit, anweisung) as g:
    79	            ergebnis["codex"] = g.codex_version
    80	            for frage in fragen:
    81	                # {"falls_rueckfrage": "Ja."}: die vorbereitete Antwort eines Nutzers, der nur antwortet, wenn gefragt
    82	                if isinstance(frage, dict):
    83	                    letzte = ergebnis["runden"][-1].get("antwort", "") if ergebnis["runden"] else ""
    84	                    if not letzte.lstrip().startswith("[Rückfrage]"):
    85	                        continue
    86	                    frage = frage["falls_rueckfrage"]
    87	                try:
    88	                    r = g.frage(frage)
    89	                except Sitzungsfehler as fehler:
    90	                    ergebnis["runden"].append({"frage": frage, "fehler": str(fehler)})
    91	                    break
    92	                ergebnis["runden"].append({
    93	                    "frage": frage, "antwort": r.text, "sekunden": r.sekunden, "token": r.token,
    94	                    "modellanfragen": r.modellanfragen,
    95	                    "schritte": [s for s in map(schritt, r.items) if s],
    96	                })
    97	                print(f"[{nummer}] {r.sekunden:>6}s  {frage[:70]}", flush=True)
    98	    except Sitzungsfehler as fehler:
    99	        ergebnis["fehler"] = str(fehler)
   100	        print(f"[{nummer}] FEHLER {fehler}", flush=True)
   101	    # Erzeugte Dateien (Diagramme, Tabellen) mit dem Lauf sichern, das Gesprächsverzeichnis ist nur Arbeitsfläche
   102	    ziel = DATEN / "laeufe" / lauf / f"dateien-{nummer:02d}"
   103	    dateien = [p for p in arbeit.rglob("*") if p.is_file() and not p.is_symlink()
   104	               and not any(t.startswith(".") for t in p.relative_to(arbeit).parts)]
   105	    for pfad in dateien:
   106	        (ziel / pfad.relative_to(arbeit)).parent.mkdir(parents=True, exist_ok=True)
   107	        shutil.copy2(pfad, ziel / pfad.relative_to(arbeit))
   108	    ergebnis["dateien"] = [str(p.relative_to(arbeit)) for p in dateien]
   109	    shutil.rmtree(arbeit, ignore_errors=True)  # Daten bleiben nur im Lauf (root), nicht im Bereich der Modell-Shell
   110	    return ergebnis
   111	
   112	
   113	def bericht(lauf, stand, ergebnisse):
   114	    teile = [f"# Lauf {lauf}\n\nDatenstand {stand}\n"]
   115	    for e in ergebnisse:
   116	        teile.append(f"\n---\n\n## Gespräch {e['nummer']}\n")
   117	        if e.get("fehler"):
   118	            teile.append(f"**Fehler:** {e['fehler']}\n")
   119	        for r in e["runden"]:
   120	            teile.append(f"\n### Frage: {r['frage']}\n")
   121	            if r.get("fehler"):
   122	                teile.append(f"**Fehler:** {r['fehler']}\n")
   123	                continue
   124	            sql = sum(1 for s in r["schritte"] if s["art"] == "sql")
   125	            befehle = sum(1 for s in r["schritte"] if s["art"] == "befehl")
   126	            teile.append(f"*{r['sekunden']} s, {sql} SQL-Abfragen, {befehle} Shell-Befehle, "
   127	                         f"{r['token'].get('inputTokens', '?')} Eingabe-Token*\n\n{r['antwort']}\n")
   128	    return "\n".join(teile)
   129	
   130	
   131	def main():
   132	    parser = argparse.ArgumentParser()
   133	    parser.add_argument("fragen")
   134	    parser.add_argument("--parallel", type=int, default=3)
   135	    args = parser.parse_args()
   136	    gespraeche = json.loads(Path(args.fragen).read_text(encoding="utf-8"))
   137	    stand, schema = datenstand()
   138	    anweisung = kontext.anweisung(APP / "katalog", APP / "wissen", stand)
   139	    lauf = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
   140	    ablage = DATEN / "laeufe" / lauf
   141	    ablage.mkdir(parents=True)
   142	    with ThreadPoolExecutor(args.parallel) as pool:
   143	        ergebnisse = list(pool.map(lambda nf: gespraech_fuehren(nf[0], nf[1], anweisung, lauf),
   144	                                   enumerate(gespraeche, 1)))
   145	    version = (APP / "VERSION").read_text().strip() if (APP / "VERSION").exists() else "?"
   146	    (ablage / "ergebnis.json").write_text(json.dumps(
   147	        {"lauf": lauf, "version": version, "schema": schema, "anweisung": anweisung, "gespraeche": ergebnisse},
   148	        ensure_ascii=False, indent=1), encoding="utf-8")
   149	    (ablage / "bericht.md").write_text(bericht(lauf, stand, ergebnisse), encoding="utf-8")
   150	    print(ablage)
   151	
   152	
   153	if __name__ == "__main__":
   154	    main()


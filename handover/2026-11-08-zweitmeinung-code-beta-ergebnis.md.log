     1	"""Fortschritt einer Runde für die Oberfläche, aus den Ereignissen des app-servers (Parameter `beobachter`).
     2	
     3	Schritte in Klartext: die Überschriften der Denkzusammenfassungen, Datenabfragen mit ihrem Ergebnis in Zeilen,
     4	das Nachschlagen in Katalog und SAE-Wissen. Kein SQL, keine Befehle. Stufen schreiten nur vorwärts:
     5	Frage verstehen, Daten abfragen, auswerten, Antwort schreiben, mit Prüfrunde zuletzt prüfen. Während der Prüfrunde
     6	kommen die Ereignisse vom Prüfgespräch: Sie ergänzen die Schritte, ändern die Stufe aber nicht mehr.
     7	"""
     8	
     9	import json
    10	import re
    11	import threading
    12	import time
    13	
    14	STUFEN = ("verstehen", "abfragen", "analysieren", "schreiben")
    15	FETT = re.compile(r"\*\*(.+?)\*\*")
    16	
    17	
    18	def _ueberschrift(text):
    19	    """Überschrift einer Denkzusammenfassung: der fette Titel, sonst der erste Satz, höchstens 120 Zeichen."""
    20	    text = (text or "").strip()
    21	    treffer = FETT.search(text)
    22	    kurz = treffer.group(1) if treffer else re.split(r"(?<=[.!?])\s|\n", text, maxsplit=1)[0]
    23	    kurz = kurz.strip().rstrip(".:")
    24	    return kurz if len(kurz) <= 120 else kurz[:119] + "…"
    25	
    26	
    27	def _zeilen(item):
    28	    """Zeilenzahl aus dem Ergebnis des Werkzeugs sql, None wenn unbekannt, -1 bei Fehler."""
    29	    if item.get("status") == "failed" or item.get("error"):
    30	        return -1
    31	    for teil in ((item.get("result") or {}).get("content") or []):
    32	        try:
    33	            daten = json.loads(teil.get("text", ""))
    34	        except (ValueError, AttributeError, TypeError):
    35	            continue
    36	        if isinstance(daten, dict):
    37	            if daten.get("fehler"):
    38	                return -1
    39	            if isinstance(daten.get("zeilen"), list):
    40	                return len(daten["zeilen"])
    41	    return None

   398	  }
   399	
   400	  const [titel, setTitel] = useState<Record<string, string>>({});
   401	  const dateien = zug.runde?.dateien ?? [];
   402	  const dashboards = dateien.filter((d) => HTML.test(d.name));
   403	  const bilder = dateien.filter((d) => BILD.test(d.name) && !a.bilder.includes(d.url));
   404	  const andere = dateien.filter((d) => !HTML.test(d.name) && !BILD.test(d.name));
   405	  // Ein Link im Text auf ein Dashboard öffnet es im Overlay. Als eigene Seite käme nur sein Quelltext.
   406	  function dashboardLink(e: MouseEvent<HTMLDivElement>) {

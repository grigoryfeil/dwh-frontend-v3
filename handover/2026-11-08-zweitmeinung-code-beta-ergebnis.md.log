   654	    # Schutz: schreibende Anfragen nur als JSON und von der eigenen Herkunft, feste Sicherheitsköpfe
   655	
   656	    herkuenfte = {f"https://{h}" for h in e.hosts} | ({f"http://{h}" for h in e.hosts} if not e.sicher else set())
   657	
   658	    class Schutz:
   659	        def __init__(self, app):
   660	            self.app = app
   661	
   662	        async def __call__(self, scope, receive, send):
   663	            if scope["type"] != "http":
   664	                return await self.app(scope, receive, send)
   665	            koepfe = {k.decode("latin-1"): v.decode("latin-1") for k, v in scope["headers"]}
   666	            if scope["method"] not in ("GET", "HEAD"):
   667	                grund = None
   668	                herkunft = koepfe.get("origin")
   669	                if herkunft is not None and herkunft not in herkuenfte:
   670	                    grund = (403, "fremde Herkunft")
   671	                elif koepfe.get("sec-fetch-site", "same-origin") not in ("same-origin", "none"):
   672	                    grund = (403, "fremde Herkunft")
   673	                elif not koepfe.get("content-type", "").startswith("application/json"):
   674	                    grund = (415, "nur JSON")
   675	                if grund:
   676	                    return await fehler(*grund)(scope, receive, send)
   677	
   678	            async def senden(nachricht):
   679	                if nachricht["type"] == "http.response.start":
   680	                    vorhanden = {k.decode("latin-1").lower() for k, _ in nachricht.get("headers", [])}
   681	                    zusatz = [(k.encode(), v.encode()) for k, v in SEITEN_KOEPFE.items() if k.lower() not in vorhanden]
   682	                    nachricht["headers"] = list(nachricht.get("headers", [])) + zusatz
   683	                await send(nachricht)
   684	
   685	            return await self.app(scope, receive, senden)

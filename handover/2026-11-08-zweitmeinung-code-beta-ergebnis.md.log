   233	    def hole_session(request):
   234	        token = request.cookies.get(COOKIE)
   235	        if not token:
   236	            return None
   237	        jetzt = time.monotonic()
   238	        with sperre:
   239	            s = sessions.get(schluessel(token))
   240	            if s is None:
   241	                return None
   242	            if jetzt - s.zuletzt > e.session_leerlauf or jetzt - s.begonnen > e.session_absolut \
   243	                    or not kontendatei.aktiv(s.email):
   244	                eigene = session_beenden(schluessel(token)) or []
   245	            else:
   246	                s.zuletzt = jetzt
   247	                return s
   248	        for g in eigene:

    40	def schritt(item):
    41	    """Ein Item der Runde vollständig, in lesbarer Form."""
    42	    art = item.get("type")
    43	    if art == "reasoning":
    44	        return {"art": "denken", "text": "\n\n".join(item.get("summary") or [])}
    45	    if art == "mcpToolCall":
    46	        argumente = item.get("arguments") or {}
    47	        ergebnis = item.get("result") or {}
    48	        inhalt = [_json_oder_text(t.get("text")) for t in ergebnis.get("content") or [] if isinstance(t, dict)]
    49	        return {"art": "sql" if item.get("tool") == "sql" else f"werkzeug {item.get('server')}.{item.get('tool')}",
    50	                "abfrage": argumente.get("abfrage", argumente), "status": item.get("status"),
    51	                "ergebnis": inhalt[0] if len(inhalt) == 1 else inhalt, "fehler": item.get("error"),
    52	                "dauer_ms": item.get("durationMs")}
    53	    if art == "commandExecution":
    54	        return {"art": "befehl", "befehl": item.get("command"), "status": item.get("status"),
    55	                "exitcode": item.get("exitCode"), "ausgabe": item.get("aggregatedOutput"),
    56	                "dauer_ms": item.get("durationMs")}
    57	    if art == "agentMessage":
    58	        return {"art": "antwort" if item.get("phase") == "final_answer" else "nachricht", "text": item.get("text")}
    59	    if art == "fileChange":
    60	        return {"art": "dateiaenderung", "aenderungen": item.get("changes")}
    61	    if art == "userMessage":
    62	        return None
    63	    return {"art": art, "roh": item}

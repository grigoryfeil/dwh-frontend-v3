     3	// Bibliothek. Werte kommen als Zahl, als Text aus SQL-Dezimalzahlen oder als null für fehlend.
     4	import type { ReactElement } from "react";
     5	import type { Diagramm as Spec, Reihe } from "./antwort";
     6	

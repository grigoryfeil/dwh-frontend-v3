    66	def dateistand(cwd):
    67	    """Sichtbare Dateien des Gesprächsverzeichnisses mit Änderungsmerkmal, ohne versteckte und ohne Symlinks."""
    68	    stand = {}
    69	    cwd = Path(cwd)
    70	    try:
    71	        pfade = list(cwd.rglob("*"))
    72	    except OSError:
    73	        return stand
    74	    for pfad in pfade:
    75	        relativ = pfad.relative_to(cwd)
    76	        if any(teil.startswith(".") for teil in relativ.parts):
    77	            continue
    78	        try:
    79	            info = pfad.lstat()
    80	        except OSError:
    81	            continue
    82	        if stat.S_ISREG(info.st_mode):
    83	            stand[relativ.as_posix()] = (info.st_mtime_ns, info.st_size)
    84	    return stand

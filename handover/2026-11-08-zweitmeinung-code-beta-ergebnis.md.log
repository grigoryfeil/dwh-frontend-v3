   104	// Quellenbelege flach je Befund, die verschachtelte Form des Plugins (queries[].source) zusammengeführt
   105	export function quellen(teile: HostTeil[]): Beleg[] {
   106	  const out: Beleg[] = [];
   107	  for (const teil of teile) {
   108	    if (teil.name !== "sources" || !objekt(teil.inhalt) || !Array.isArray(teil.inhalt.items)) continue;
   109	    for (const item of teil.inhalt.items) {
   110	      if (!objekt(item)) continue;
   111	      const schichten: Record<string, unknown>[] = [item];
   112	      for (const q of Array.isArray(item.queries) ? item.queries : []) {
   113	        if (objekt(q)) schichten.push(q);
   114	        if (objekt(q) && objekt(q.source)) schichten.push(q.source);
   115	      }
   116	      const alle = (feld: string) => [...new Set(schichten.flatMap((s) => texte(s[feld])))];
   117	      const definitionen: Definition[] = [];
   118	      for (const s of schichten) {
   119	        for (const d of Array.isArray(s.metricDefinitions) ? s.metricDefinitions : []) {
   120	          if (!objekt(d)) continue;
   121	          // Nur Texte: Ein Objekt an dieser Stelle ließe React die ganze Antwort verwerfen
   122	          const def: Definition = {};
   123	          for (const feld of ["label", "definition", "stage"] as const) if (["string", "number"].includes(typeof d[feld])) def[feld] = String(d[feld]);
   124	          if (!definitionen.some((x) => JSON.stringify(x) === JSON.stringify(def))) definitionen.push(def);
   125	        }
   126	      }
   127	      const zeitraum = schichten.find((s) => s.reportingPeriod)?.reportingPeriod;
   128	      out.push({
   129	        title: String(item.title ?? ""),
   130	        metricDefinitions: definitionen,
   131	        tables: alle("tables"),
   132	        filters: alle("filters"),
   133	        ...(zeitraum ? { reportingPeriod: String(zeitraum) } : {}),
   134	        assumptions: alle("assumptions"),
   135	        caveats: alle("caveats"),
   136	      });
   137	    }
   138	  }
   139	  return out;
   140	}
   141	const ZAHL = /^\s*(\d|[+\-−–]\s?\d)/;
   142	const ZELLE_ZAHL = /^[+\-−–]?\s?[\d.,'\s]*\d[\d.,'\s]*\s?(%|‰|pp|pp\.|pkt\.?|€|eur|mio\.?|tsd\.?|k)?$/i;
   143	
   144	export function linkErlaubt(url: string, gespraech: string | null): boolean {
   145	  if (/^(https:|mailto:|#)/i.test(url)) return true;
   146	  return gespraech !== null && eigeneDatei(url, gespraech);
   147	}
   148	
   149	function eigeneDatei(url: string, gespraech: string): boolean {
   150	  const praefix = `/api/gespraeche/${gespraech}/dateien/`;
   151	  return url.startsWith(praefix) && url.length > praefix.length && !url.includes("..");
   152	}
   153	
   154	function parser(gespraech: string | null, bilder: string[]) {
   155	  const md = markdownit({ html: false, linkify: false, typographer: false });
   156	  md.validateLink = (url) => linkErlaubt(url, gespraech);
   157	  const r = md.renderer.rules;
   158	  r.link_open = (tokens, i, opts, _env, self) => {
   159	    const t = tokens[i];
   160	    if (!linkErlaubt(String(t.attrGet("href") ?? ""), gespraech)) {
   161	      t.meta = { gesperrt: true };
   162	      return "<span>";
   163	    }
   164	    t.attrSet("target", "_blank");
   165	    t.attrSet("rel", "noopener noreferrer");
   166	    return self.renderToken(tokens, i, opts);
   167	  };
   168	  r.link_close = (tokens, i, opts, _env, self) => {
   169	    // das zugehörige link_open steht weiter vorn auf derselben Ebene
   170	    for (let j = i - 1; j >= 0; j--) {
   171	      if (tokens[j].type === "link_open" && tokens[j].level === tokens[i].level) {
   172	        return tokens[j].meta?.gesperrt ? "</span>" : self.renderToken(tokens, i, opts);
   173	      }
   174	    }
   175	    return self.renderToken(tokens, i, opts);
   176	  };
   177	  const bild = r.image!;
   178	  r.image = (tokens, i, opts, env, self) => {
   179	    const src = String(tokens[i].attrGet("src") ?? "");
   180	    if (gespraech === null || !eigeneDatei(src, gespraech)) return md.utils.escapeHtml(tokens[i].content);
   181	    bilder.push(src);
   182	    return bild(tokens, i, opts, env, self);
   183	  };
   184	  r.table_open = () => '<div class="tabelle"><table>';
   185	  r.table_close = () => "</table></div>";
   186	  md.core.ruler.push("zahlenspalten", (state) => zahlenspalten(state.tokens));
   187	  return md;
   188	}

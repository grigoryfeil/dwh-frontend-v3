   278	// Höchstens zwei Knöpfe für andere Lesarten (6.7, Runde 6), gleiche Beschriftung nur einmal
   279	function lesartenAus(teile: HostTeil[]): Lesart[] {
   280	  const lesarten = new Map<string, Lesart>();
   281	  for (const t of teile) {
   282	    const l = t.inhalt as Lesart;
   283	    if (t.name !== "alternative_reading" || !objekt(t.inhalt) || !l.label || !l.prompt) continue;
   284	    const label = String(l.label);
   285	    if (!lesarten.has(label)) lesarten.set(label, { label, prompt: String(l.prompt) });
   286	  }
   287	  return [...lesarten.values()].slice(0, 2);
   288	}

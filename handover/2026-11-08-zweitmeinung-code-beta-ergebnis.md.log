   290	export function zerlege(text: string, gespraech: string | null): Antwort {
   291	  const bilder: string[] = [];
   292	  const md = parser(gespraech, bilder);
   293	  const host = hostTeile(text.replace(/\r\n/g, "\n"));
   294	  text = host.text;
   295	  const zeilen = text.split("\n");
   296	  const erste = zeilen.findIndex((z) => z.trim() !== "");
   297	  const marke = erste >= 0 ? MARKE.exec(zeilen[erste]) : null;
   298	
   299	  if (marke) {
   300	    let rest = zeilen.slice(erste + 1);
   301	    let titel = marke[2].trim();
   302	    if (!titel) {
   303	      const k = rest.findIndex((z) => z.trim() !== "");
   304	      titel = k >= 0 ? rest[k] : "";
   305	      rest = rest.slice(k + 1);
   306	    }
   307	    titel = md.renderInline(titel.replace(/^#+\s*/, "").replace(/^\*\*(.*)\*\*$/, "$1").trim());
   308	    const env = {};
   309	    const tokens = md.parse(rest.join("\n"), env);
   310	    if (/^(keine antwort|no answer)$/i.test(marke[1])) {
   311	      // seit 6.7 mit Knopf für eine eng verwandte Auswertung, die die Daten tragen
   312	      return { art: "keine", titel, rest: md.renderer.render(tokens, md.options, env), lesarten: lesartenAus(host.teile) };
   313	    }
   314	    const bl = bloecke(tokens);
   315	    const letzte = bl.length - 1;
   316	    const optionen = letzte >= 0 && istListe(bl[letzte]) ? eintraege(bl[letzte]).map((o) => o.trim()) : [];
   317	    const ohne = optionen.length ? bl.slice(0, letzte).flat() : tokens;
   318	    const art: "rueckfrage" | "kurzklaerung" = /^(rückfrage|rueckfrage|clarification)$/i.test(marke[1]) ? "rueckfrage" : "kurzklaerung";
   319	    return { art, titel, rest: md.renderer.render(ohne, md.options, env), optionen };
   320	  }
   321	
   322	  const env = {};
   323	  const tokens = md.parse(text, env);
   324	  const bl = bloecke(tokens);
   325	  let lead = "";
   326	  let ab = 0;
   327	  if (bl[0]?.[0].type === "paragraph_open") {
   328	    lead = md.renderer.renderInline(bl[0][1].children ?? [], md.options, env);
   329	    ab = 1;
   330	  }
   331	  const kz = ab === 1 ? kennzahlen(bl[1], md) : null;
   332	  if (kz) ab = 2;
   333	  const rest = md.renderer.render(bl.slice(ab).flat(), md.options, env);
   334	  const tabellen = tokens.filter((t) => t.type === "table_open").length;
   335	  const diagramme = host.teile.filter((t) => t.name === "charts_widget_v2" && objekt(t.inhalt)).map((t) => t.inhalt as Diagramm);
   336	  const lesarten = lesartenAus(host.teile);
   337	  // Annahmen der Abfrage, seit 0.5.2 eine eigene Zeile des Modells, die die Seite an den Beleg der Anwendung hängt
   338	  const annahmen = [...new Set(host.teile.filter((t) => t.name === "assumptions").flatMap((t) => texte(t.inhalt)))];
   339	  return { art: "antwort", lead, kennzahlen: kz ?? [], rest, tabellen, bilder, diagramme, quellen: quellen(host.teile), annahmen, lesarten,
   340	    unvollstaendig: host.teile.some((t) => t.name === "ungueltig") };
   341	}

   190	// Spalten, deren Zellen alle Zahlen sind, rechtsbündig wie im Entwurf
   191	function zahlenspalten(tokens: Token[]) {
   192	  for (let i = 0; i < tokens.length; i++) {
   193	    if (tokens[i].type !== "table_open") continue;
   194	    const zeilen: Token[][] = [];
   195	    let zeile: Token[] = [];
   196	    let j = i + 1;
   197	    for (; j < tokens.length && tokens[j].type !== "table_close"; j++) {
   198	      const t = tokens[j];
   199	      if (t.type === "tr_open") zeile = [];
   200	      if (t.type === "th_open" || t.type === "td_open") zeile.push(t);
   201	      if (t.type === "tr_close") zeilen.push(zeile);
   202	    }
   203	    const inhalt = (zelle: Token) => tokens[tokens.indexOf(zelle) + 1]?.content?.trim() ?? "";
   204	    const spalten = Math.max(0, ...zeilen.map((z) => z.length));
   205	    for (let s = 1; s < spalten; s++) {
   206	      const werte = zeilen.slice(1).map((z) => (z[s] ? inhalt(z[s]) : ""));
   207	      if (werte.length && werte.every((w) => w === "" || w === "–" || ZELLE_ZAHL.test(w)) && werte.some((w) => w)) {
   208	        for (const z of zeilen) z[s]?.attrJoin("class", "zahl");
   209	      }
   210	    }
   211	    i = j;
   212	  }
   213	}

   412	  }
   413	  const p = zug.runde?.pruefung;
   414	  const hinweis = p && (p.status === "hinweis" || p.status === "gescheitert") && p.hinweis ? p.hinweis : null;
   415	
   416	  return (
   417	    <section className="abschnitt zug" lang={lang}>
   418	      <div className="rand">

   358	  const meta = zug.fertig ? `${uhrzeit(zug.fertig)} · ${dauer(zug.fertig.getTime() - zug.zeit.getTime())}${vermerk}` : "";
   359	
   360	  if (a.art === "keine" || a.art === "rueckfrage" || a.art === "kurzklaerung") {
   361	    return (
   362	      <section className="abschnitt zug" lang={lang}>
   363	        <div className="rand">
   364	          <b>{a.art === "keine" ? "Answer" : a.art === "kurzklaerung" ? "Before building" : "Clarification"}</b>
   365	          <span>{zug.fertig ? uhrzeit(zug.fertig) : ""}</span>
   366	        </div>
   367	        <div className="spalte schmal">
   368	          <p className="titel22" dangerouslySetInnerHTML={html(a.titel)} />
   369	          <div className="text16" dangerouslySetInnerHTML={html(a.rest)} />
   370	          {a.art === "keine" && <Lesarten lesarten={a.lesarten} arbeitet={props.arbeitet} onOption={props.onOption} />}
   371	          {a.art === "rueckfrage" && a.optionen.length > 0 && (
   372	            <div className="optionen">
   373	              {a.optionen.map((o) => (
   374	                <button key={o} disabled={props.arbeitet} onClick={() => props.onOption(o)}>
   375	                  {o}
   376	                </button>
   377	              ))}
   378	            </div>
   379	          )}
   380	          {a.art === "kurzklaerung" && (
   381	            <>
   382	              {a.optionen.length > 0 && (
   383	                <ol className="klaerung">
   384	                  {a.optionen.map((o) => <li key={o} dangerouslySetInnerHTML={html(inline(o, gespraech))} />)}
   385	                </ol>
   386	              )}
   387	              <div className="optionen">
   388	                <button className="so-bauen" disabled={props.arbeitet} onClick={() => props.onOption(lang === "de" ? "So bauen." : "Build it this way.")}>
   389	                  {lang === "de" ? "So bauen" : "Build it this way"}
   390	                </button>
   391	                <span className="meta">{lang === "de" ? "Oder Änderungen unten eingeben." : "Or type changes below."}</span>
   392	              </div>
   393	            </>

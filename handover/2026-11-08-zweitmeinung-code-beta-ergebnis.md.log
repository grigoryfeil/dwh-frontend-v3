    44	class Fortschritt:
    45	    def __init__(self, uhr=time.monotonic, pruefen=False):
    46	        self.uhr = uhr
    47	        self.namen = STUFEN + (("pruefen",) if pruefen else ())
    48	        self._pruefung = False
    49	        self.start = uhr()
    50	        self.schritte = []
    51	        self._stufe = 0
    52	        self._sql = 0
    53	        self._sql_offen = 0
    54	        self._nummern = {}  # Kennung des Aufrufs -> Nummer der Abfrage, Abfragen laufen auch parallel
    55	        self._sperre = threading.Lock()
    56	
    57	    def sekunden(self):
    58	        return round(self.uhr() - self.start, 1)
    59	

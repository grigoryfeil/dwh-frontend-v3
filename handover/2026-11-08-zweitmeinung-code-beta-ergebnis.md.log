   256	function kennzahlen(block: Token[] | undefined, md: ReturnType<typeof markdownit>): Kennzahl[] | null {
   257	  if (!block || block[0].type !== "bullet_list_open") return null;
   258	  const texte = eintraege(block);
   259	  if (!texte.length || texte.length > 6) return null;
   260	  const out: Kennzahl[] = [];
   261	  for (const text of texte) {
   262	    const t = /^\*\*([^*]{1,40})\*\*\s*[:–—-]?\s*(.+)$/s.exec(text.trim());
   263	    if (!t || !ZAHL.test(t[1])) return null;
   264	    const w = /^([+\-−–]?\s?\d[\d.,'\s]*\d|[+\-−–]?\s?\d)\s*(.*)$/.exec(t[1].trim());
   265	    out.push({
   266	      wert: (w ? w[1] : t[1]).replace(/\s+/g, " ").replace(/^-/, "−"),
   267	      einheit: w ? w[2] : "",
   268	      label: md.renderInline(t[2].trim()),
   269	    });
   270	  }
   271	  return out;
   272	}
   273	
   274	function istListe(block: Token[]) {
   275	  return block[0].type === "bullet_list_open" || block[0].type === "ordered_list_open";
   276	}

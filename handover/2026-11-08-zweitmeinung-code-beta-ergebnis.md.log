   215	// Blöcke der obersten Ebene: von einem öffnenden Token bis zu seinem schließenden, oder ein Einzeltoken
   216	function bloecke(tokens: Token[]): Token[][] {
   217	  const out: Token[][] = [];
   218	  let i = 0;
   219	  while (i < tokens.length) {
   220	    const t = tokens[i];
   221	    if (t.nesting !== 1) {
   222	      out.push([t]);
   223	      i++;
   224	      continue;
   225	    }
   226	    let tiefe = 0;
   227	    let j = i;
   228	    for (; j < tokens.length; j++) {
   229	      tiefe += tokens[j].nesting;
   230	      if (tiefe === 0) break;
   231	    }
   232	    out.push(tokens.slice(i, j + 1));
   233	    i = j + 1;
   234	  }
   235	  return out;
   236	}

   116	    main(sys.argv[1:])
     1	"""Dateien, die das Modell im eigenen Gesprächsverzeichnis ablegt und in der Antwort nennt, etwa Diagramme.
     2	
     3	Das Modell verweist mit absolutem Pfad (`/var/lib/dwh-frontend-v3/gespraeche/web-<id>/bild.png`) oder relativ
     4	(`bild.png`) darauf. Solche Verweise werden in den Vertrag der Oberfläche übersetzt
     5	(`/api/gespraeche/<id>/dateien/<name>`) und als `dateien` der Runde gemeldet. Nur gemeldete Dateien werden
     6	ausgeliefert, nur reguläre Dateien innerhalb des Verzeichnisses, ohne Symlinks: Bilder, Tabellen und Dashboards.
     7	Andere Pfade bleiben Text.
     8	
     9	Dashboards (Data App des Data-Plugins) sind eigenständiges HTML mit Skript und eingebetteten Daten. Sie laufen nur im
    10	Rahmen der eigenen Seite (`Sec-Fetch-Dest: iframe`, `frame-ancestors 'self'`) in einer Sandbox mit fremdem Ursprung,
    11	ohne Netz (kein `connect-src`), ohne Formulare und Navigation. Als eigene Seite aufgerufen kommen sie als Quelltext,
    12	der nichts ausführt; so liest die Oberfläche auch den Titel. SVG bleibt draußen, es trüge Skript in ein `<img>`.
    13	"""
    14	
    15	import os
    16	import re
    17	import stat
    18	from urllib.parse import quote, unquote
    19	
    20	ARTEN = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "gif": "image/gif", "webp": "image/webp",
    21	         "csv": "text/csv", "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    22	         "html": "text/html; charset=utf-8", "htm": "text/html; charset=utf-8"}
    23	BILD = {"png", "jpg", "jpeg", "gif", "webp"}
    24	HTML = {"html", "htm"}
    25	NAME = re.compile(r"[\w][\w.\- ]{0,200}(?:/[\w][\w.\- ]{0,200}){0,4}")
    26	KOEPFE = {"Content-Security-Policy": "default-src 'none'; sandbox", "X-Content-Type-Options": "nosniff"}
    27	# data: in script-src, weil die Laufzeit der Data App als <script src="data:..."> in der Datei steckt. Das ist kein
    28	# Netz und erlaubt nichts, was 'unsafe-inline' nicht schon erlaubt. Kein connect-src: Nachladen bleibt gesperrt.
    29	DASHBOARD_CSP = ("sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' data:; style-src 'unsafe-inline'; "
    30	                 "img-src data: blob:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'")
    31	# Knöpfe der Data App, die nur in ChatGPT funktionieren (Veröffentlichen, Fragen, Bearbeiten, Menü), wie in V2
    32	AUSBLENDEN = (b"<style>.dashboard-publish-button,.dashboard-publish-confirm,.publish-review-dialog,.dashboard-ask-anchor,"
    33	              b".dashboard-ask-button,.dashboard-ask-panel,.dashboard-header-edit-button,"
    34	              b".dashboard-header-overflow-button{display:none!important}</style>")
    35	ANKER = [re.compile(rb"<" + tag + rb"\b[^>]{0,1000}>", re.I) for tag in (rb"head", rb"html", rb"!doctype")]
    36	
    37	
    38	def auslieferung(name, inhalt, ziel):
    39	    """Inhalt, Medientyp und Köpfe für eine gemeldete Datei. `ziel` ist Sec-Fetch-Dest der Anfrage."""
    40	    endung = name.rsplit(".", 1)[-1].lower()
    41	    if endung in HTML:
    42	        koepfe = {"Content-Security-Policy": DASHBOARD_CSP, "X-Content-Type-Options": "nosniff",
    43	                  "Content-Disposition": "inline"}
    44	        if ziel != "iframe":
    45	            return inhalt, "text/plain; charset=utf-8", koepfe
    46	        for anker in ANKER:  # hinter <head>, sonst <html> oder den Doctype, davor fiele es in den Quirks-Modus
    47	            if treffer := anker.search(inhalt):
    48	                return inhalt[:treffer.end()] + AUSBLENDEN + inhalt[treffer.end():], ARTEN[endung], koepfe
    49	        return AUSBLENDEN + inhalt, ARTEN[endung], koepfe
    50	    art = "inline" if endung in BILD else f"attachment; filename=\"{quote(name.split('/')[-1])}\""
    51	    return inhalt, ARTEN[endung], {**KOEPFE, "Content-Disposition": art}
    52	
    53	
    54	def oeffne(cwd, name):
    55	    """Öffnet cwd/name Teil für Teil ohne Symlinks zu folgen, None wenn es keine reguläre Datei ist."""
    56	    try:
    57	        fd = os.open(cwd, os.O_RDONLY | os.O_DIRECTORY)
    58	    except OSError:
    59	        return None
    60	    try:
    61	        teile = name.split("/")
    62	        for teil in teile[:-1]:
    63	            neu = os.open(teil, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
    64	            os.close(fd)
    65	            fd = neu
    66	        datei = os.open(teile[-1], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    67	    except OSError:
    68	        return None
    69	    finally:
    70	        os.close(fd)
    71	    if not stat.S_ISREG(os.fstat(datei).st_mode):
    72	        os.close(datei)
    73	        return None
    74	    return os.fdopen(datei, "rb")
    75	
    76	
    77	def gueltig(cwd, name):
    78	    if not NAME.fullmatch(name) or ".." in name or name.rsplit(".", 1)[-1].lower() not in ARTEN:
    79	        return False
    80	    datei = oeffne(cwd, name)
    81	    if datei is None:
    82	        return False
    83	    datei.close()
    84	    return True

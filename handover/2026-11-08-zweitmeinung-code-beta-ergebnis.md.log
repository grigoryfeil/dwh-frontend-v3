   238	function eintraege(block: Token[]): string[] {
   239	  // Rohtext je Listenpunkt, nur der erste Absatz
   240	  const texte: string[] = [];
   241	  let tiefe = 0;
   242	  let neu = false;
   243	  for (const t of block) {
   244	    if (t.type === "list_item_open") {
   245	      tiefe++;
   246	      neu = tiefe === 1;
   247	    } else if (t.type === "list_item_close") tiefe--;
   248	    else if (t.type === "inline" && neu) {
   249	      texte.push(t.content);
   250	      neu = false;
   251	    }
   252	  }
   253	  return texte;
   254	}

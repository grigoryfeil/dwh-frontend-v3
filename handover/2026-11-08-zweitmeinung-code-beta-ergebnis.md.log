   221	  async function starte(id: number, text: string, optionen: api.Optionen) {
   222	    try {
   223	      let antwort: { gespraech: string };
   224	      try {
   225	        antwort = await api.fragen(text, gespraech.current, optionen);
   226	      } catch (e) {
   227	        // Gespräch inzwischen beendet: neu beginnen
   228	        if (!(e instanceof Antwortfehler && (e.status === 404 || e.status === 410) && gespraech.current)) throw e;
   229	        gespraech.current = null;
   230	        antwort = await api.fragen(text, null, optionen);
   231	      }
   232	      gespraech.current = antwort.gespraech;
   233	      aendere(id, { gespraech: antwort.gespraech });
   234	      await verfolge(antwort.gespraech, id);
   235	    } catch (e) {
   236	      if (e instanceof Abgemeldet) return abgemeldet();
   237	      aendere(id, { fehler: e instanceof Antwortfehler && e.status === 503 ? "belegt" : "verbindung", fertig: new Date() });
   238	    }
   239	  }
   240	
   241	  function frage(text: string, mitPruefung = verify, mitSchnell = schnell) {
   242	    const t = text.trim();
   243	    if (!t || laufend) return;
   244	    const id = ++zaehler.current;
   245	    setZuege((zs) => [...zs, { id, frage: t, zeit: new Date(), verify: mitPruefung, schnell: mitSchnell }]);
   246	    setEntwurf("");
   247	    setVerify(false); // gilt nur für die nächste Frage
   248	    void starte(id, t, { verifizieren: mitPruefung, speichern: ablage && speichern, schnell: mitSchnell });
   249	  }
   250	
   251	  function waehleBeispiel(text: string) {
   252	    setMenue(null);
   253	    setEntwurf(text);
   254	    setFokus((f) => f + 1); // ins Feld, nicht abschicken. Läuft gerade eine Antwort, steht die Frage danach im Folgefeld
   255	  }
   256	
   257	  async function abbrechen() {
   258	    if (!laufend || !gespraech.current) return;
   259	    aendere(laufend.id, { abbrechen: true });
   260	    try {
   261	      await api.abbrechen(gespraech.current);
   262	    } catch (e) {
   263	      if (e instanceof Abgemeldet) abgemeldet();
   264	      // 409: Die Runde endete schon, die Verfolgung zeigt das Ergebnis
   265	    }
   266	  }
   267	
   268	  function nochmal(zug: Zug) {
   269	    setZuege((zs) => zs.filter((z) => z.id !== zug.id));
   270	    frage(zug.frage, zug.verify, zug.schnell);
   271	  }

   252	    def raeumen():
   253	        """Leerlauf: abgelaufene Sessions und ruhende Gespräche schließen, jede Minute."""
   254	        while True:
   255	            time.sleep(60)
   256	            jetzt = time.monotonic()
   257	            zu = []
   258	            with sperre:
   259	                for schl, s in list(sessions.items()):
   260	                    if jetzt - s.zuletzt > e.session_leerlauf or jetzt - s.begonnen > e.session_absolut:
   261	                        zu += session_beenden(schl) or []
   262	                for g in list(gespraeche.values()):
   263	                    if not g.laeuft and jetzt - g.zuletzt > e.leerlauf:
   264	                        del gespraeche[g.kennung]
   265	                        zu.append(g)
   266	            for g in zu:
   267	                g.schliessen()
   268	

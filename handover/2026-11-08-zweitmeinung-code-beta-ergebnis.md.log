   693	        Route("/api/ich", ich),
   694	        Route("/api/fragen", fragen, methods=["POST"]),
   695	        Route("/api/gespraeche/{kennung}", gespraech, methods=["GET", "DELETE"]),
   696	        Route("/api/gespraeche/{kennung}/abbrechen", abbrechen, methods=["POST"]),

     1	"""Führt Gespräche aus einer Fragendatei durch den Harness und legt die vollständigen Ausgaben ab.
     2	
     3	Aufruf auf dem VPS als root: `python3 -I lauf.py fragen.json [--parallel 3]`. Ergebnis unter
     4	`/var/lib/dwh-frontend-v3/laeufe/<zeitstempel>/`: `ergebnis.json` (alles) und `bericht.md` (zum Lesen).
     5	"""
     6	
     7	import argparse
     8	import configparser
     9	import datetime
    10	import json
    11	import os
    12	import shutil
    13	import sys
    14	from concurrent.futures import ThreadPoolExecutor
    15	from pathlib import Path
    16	
    17	sys.path.insert(0, str(Path(__file__).resolve().parent))
    18	import kontext  # noqa: E402
    19	from sitzung import Gespraech, Sitzungsfehler  # noqa: E402
    20	
    21	APP = Path("/opt/dwh-frontend-v3/app")
    22	DATEN = Path("/var/lib/dwh-frontend-v3")
    23	OPTIONSDATEI = "/etc/dwh-frontend-v3/dwh-leser.cnf"
    24	
    25	
    26	def datenstand():
    27	    optionen = configparser.ConfigParser(interpolation=None)
    28	    optionen.read(OPTIONSDATEI)
    29	    schema = optionen["client"]["database"]  # b_YYYYMMDDtHHMMSSz_xxxx
    30	    return datetime.datetime.strptime(schema[2:10], "%Y%m%d").strftime("%d.%m.%Y"), schema
    31	
    32	
    33	GRENZE = 200_000  # Zeichen je Werkzeugergebnis, schützt nur vor Ausreißern
    34	
    35	
    36	def _ergebnis_text(ergebnis):
    37	    """Text eines MCP-Ergebnisses: der Inhalt des Werkzeugs `sql` ist JSON mit spalten, zeilen, gekuerzt."""
    38	    if not isinstance(ergebnis, dict):
    39	        return ergebnis
    40	    teile = [c.get("text", "") for c in ergebnis.get("content") or [] if isinstance(c, dict)]
    41	    text = "\n".join(teile) if teile else json.dumps(ergebnis, ensure_ascii=False)
    42	    try:
    43	        return json.loads(text)
    44	    except (ValueError, TypeError):
    45	        return text[:GRENZE]
    46	
    47	
    48	def schritt(item):
    49	    """Ein Schritt der Runde, vollständig genug, um Antwort, Tabelle und Diagramm nachzuvollziehen."""
    50	    s = _schritt(item)
    51	    if s is not None:
    52	        s["sekunde"] = item.get("_sekunde")
    53	    return s
    54	
    55	
    56	def _schritt(item):
    57	    art = item.get("type")
    58	    if art == "mcpToolCall":
    59	        argumente = item.get("arguments") or {}
    60	        return {"art": "sql", "abfrage": argumente.get("abfrage", argumente),
    61	                "ergebnis": _ergebnis_text(item.get("result")), "fehler": item.get("error")}
    62	    if art == "commandExecution":
    63	        return {"art": "befehl", "befehl": str(item.get("command")),
    64	                "ausgabe": str(item.get("aggregatedOutput") or "")[:GRENZE], "exitcode": item.get("exitCode")}
    65	    if art == "reasoning":
    66	        return {"art": "denken", "text": " ".join(item.get("summary") or [])}
    67	    if art == "fileChange":
    68	        return {"art": "datei", "aenderungen": [c.get("path") for c in item.get("changes") or []]}
    69	    return None
    70	

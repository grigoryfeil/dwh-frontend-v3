    91	class Ablage:
    92	    def __init__(self, wurzel):
    93	        self.wurzel = Path(wurzel)
    94	
    95	    def _ordner(self, *teile):
    96	        """Jede Stufe einzeln mit 0700, mkdir mit parents gäbe den Zwischenstufen die Umask."""
    97	        pfad = self.wurzel
    98	        pfad.mkdir(mode=0o700, parents=True, exist_ok=True)
    99	        for teil in teile:
   100	            pfad = pfad / teil
   101	            pfad.mkdir(mode=0o700, exist_ok=True)
   102	        return pfad
   103	
   104	    @staticmethod
   105	    def _schreibe(pfad, inhalt):
   106	        """Erst in eine temporäre Datei, dann umbenennen: Wer liest, sieht nie eine halbe Datei."""
   107	        zwischen = pfad.with_name(f".{pfad.name}.{secrets.token_hex(4)}")
   108	        with os.fdopen(os.open(zwischen, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as datei:
   109	            if isinstance(inhalt, bytes):
   110	                datei.write(inhalt)
   111	            else:
   112	                shutil.copyfileobj(inhalt, datei)
   113	        os.replace(zwischen, pfad)
   114	
   115	    @staticmethod
   116	    def _json(daten):
   117	        return json.dumps(daten, ensure_ascii=False, indent=1).encode()
   118	
   119	    def anweisung(self, text):
   120	        pruefsumme = hashlib.sha256(text.encode()).hexdigest()[:16]
   121	        pfad = self._ordner("anweisungen") / f"{pruefsumme}.txt"
   122	        if not pfad.exists():
   123	            self._schreibe(pfad, text.encode())
   124	        return pruefsumme
   125	
   126	    def gespraech(self, datum, kennung, daten):
   127	        self._schreibe(self._ordner(datum, kennung) / "gespraech.json", self._json(daten))
   128	
   129	    def dateien(self, datum, kennung, nummer, namen, oeffne):
   130	        """Kopiert Dateien einer Runde, `oeffne(name)` folgt keinen Verweisen. Liefert die abgelegten Namen."""
   131	        ziel = self.wurzel / datum / kennung / "dateien" / str(nummer)
   132	        abgelegt, summe = [], 0
   133	        for name in namen:
   134	            datei = oeffne(name)
   135	            if datei is None:
   136	                continue
   137	            with datei:
   138	                groesse = os.fstat(datei.fileno()).st_size
   139	                if groesse > DATEI_MAX or summe + groesse > RUNDE_MAX:
   140	                    continue
   141	                pfad = ziel / name
   142	                if ".." in Path(name).parts:
   143	                    continue
   144	                self._ordner(*pfad.parent.relative_to(self.wurzel).parts)
   145	                self._schreibe(pfad, datei)
   146	            summe += groesse
   147	            abgelegt.append(name)
   148	        return abgelegt
   149	
   150	    def feedback(self, daten):
   151	        name = f"{datetime.datetime.now().strftime('%Y%m%dT%H%M%S')}-{secrets.token_hex(4)}.json"
   152	        self._schreibe(self._ordner("feedback") / name, self._json(daten))
   153	        return name

    47	class Konten:
    48	    """Liest die Kontendatei bei jeder Änderung neu, so wirken Sperren ohne Neustart."""
    49	
    50	    def __init__(self, pfad):
    51	        self.pfad = Path(pfad)
    52	        self._stand, self._konten = None, {}
    53	        self._sperre = threading.Lock()
    54	        self._attrappe = hash_von(secrets.token_urlsafe(16))
    55	
    56	    def _lade(self):
    57	        try:
    58	            merkmal = self.pfad.stat().st_mtime_ns
    59	        except OSError:
    60	            return {}
    61	        with self._sperre:
    62	            if merkmal != self._stand:
    63	                try:
    64	                    daten = json.loads(self.pfad.read_text(encoding="utf-8") or "{}")
    65	                except (OSError, ValueError):
    66	                    daten = {}
    67	                self._konten = daten if isinstance(daten, dict) else {}
    68	                self._stand = merkmal
    69	            return self._konten
    70	
    71	    def aktiv(self, email):
    72	        konto = self._lade().get(normalisiere(email))
    73	        return isinstance(konto, dict) and konto.get("aktiv", True) and isinstance(konto.get("hash"), str)
    74	
    75	    def pruefe(self, email, passwort):
    76	        konto = self._lade().get(normalisiere(email))
    77	        ok = stimmt(passwort, konto["hash"] if self.aktiv(email) else self._attrappe)
    78	        return ok and self.aktiv(email)
    79	
    80	
    81	def _schreibe(pfad, konten):
    82	    neu = Path(f"{pfad}.neu")
    83	    neu.write_text(json.dumps(konten, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    84	    try:
    85	        st = os.stat(pfad)
    86	        os.chown(neu, st.st_uid, st.st_gid)
    87	        os.chmod(neu, st.st_mode & 0o777)
    88	    except FileNotFoundError:
    89	        os.chmod(neu, 0o640)
    90	    os.replace(neu, pfad)
    91	

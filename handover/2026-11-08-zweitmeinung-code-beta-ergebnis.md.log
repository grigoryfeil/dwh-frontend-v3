   397	            meldung = str(fehl) if isinstance(fehl, Sitzungsfehler) else "interner Fehler"
   398	            protokolliere(eintrag, nummer, "fehler", fehler=meldung)
   399	            with sperre:
   400	                if eintrag.abbruch:
   401	                    runde["abgebrochen"] = True
   402	                else:
   403	                    runde["fehler"] = meldung
   404	                eintrag.laeuft, eintrag.fortschritt = False, None
   405	            archiviere(eintrag, nummer, runde, "abgebrochen" if eintrag.abbruch else "fehler", items, vorher)
   406	            eintrag.schliessen()
   407	            return
   408	        if eintrag.abbruch:  # wer abbricht, will die Antwort nicht mehr, auch wenn sie schon stand
   409	            return abgebrochen(ergebnis)
   410	        text, ergebnis_pruefung = ergebnis.text, None
   411	        if runde.get("verifizieren"):
   412	            text, ergebnis_pruefung = pruefe(eintrag, runde, text, beobachter)
   413	            if eintrag.abbruch:
   414	                return abgebrochen(ergebnis)
   415	        protokolliere(eintrag, nummer, "fertig", ergebnis)
   416	        antwort, gemeldet = dateien.uebersetze(text, eintrag.cwd, eintrag.kennung)
   417	        with sperre:
   418	            if ergebnis_pruefung:
   419	                runde["pruefung"] = ergebnis_pruefung
   420	            runde.update(antwort=antwort, dateien=gemeldet, ms=int(ergebnis.sekunden * 1000),
   421	                         stufen=beobachter.stufen(fertig=True), schritte=beobachter.schritte)
   422	            eintrag.laeuft, eintrag.fortschritt = False, None
   423	            eintrag.zuletzt = time.monotonic()
   424	        archiviere(eintrag, nummer, runde, "fertig", ergebnis.items, vorher, ergebnis)

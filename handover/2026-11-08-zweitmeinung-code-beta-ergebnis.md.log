   212	        setZuege((zs) => zs.filter((z) => z.id !== id));
   213	        setEntwurf(runde?.frage ?? "");
   214	        return;
   215	      }
   216	      if (runde.fehler) return aendere(id, { fehler: runde.fehler === "Zeitlimit" ? "zeit" : "verbindung", fertig: new Date() });
   217	      return aendere(id, { runde, fertig: new Date() });
   218	    }
   219	  }

    10	// Text aus dem JSON des Modells: Objekte an dieser Stelle würden React die ganze Antwort verwerfen lassen
    11	const text = (w: unknown) => (typeof w === "string" || typeof w === "number" ? String(w) : "");
    12	
    13	function zahl(w: unknown): number | null {
    14	  if (typeof w === "number") return Number.isFinite(w) ? w : null;
    15	  if (typeof w === "string" && /^\s*-?\d+(\.\d+)?\s*$/.test(w)) return Number(w);
    16	  return null;
    17	}
    18	
    19	function format(lang: string, w: number, reihe?: Reihe) {
    20	  const ziffern = Math.abs(w) >= 100 || Number.isInteger(w) ? 0 : Math.abs(w) >= 10 ? 1 : 2;
    21	  const zahltext = new Intl.NumberFormat(lang === "de" ? "de-DE" : "en-GB", { maximumFractionDigits: ziffern }).format(w);
    22	  return `${text(reihe?.valuePrefix)}${zahltext}${text(reihe?.valueSuffix)}`;
    23	}

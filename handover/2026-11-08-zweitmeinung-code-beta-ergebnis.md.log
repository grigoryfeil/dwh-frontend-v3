   438	        {a.diagramme.map((d, i) => <DiagrammAnsicht key={i} spec={d} lang={lang} />)}
   439	        {a.rest && <div className="md" onClick={dashboardLink} dangerouslySetInnerHTML={html(a.rest)} />}
   440	        {a.unvollstaendig && <div className="meta">Part of this answer could not be displayed.</div>}
   441	        {hinweis && (
   442	          <div className="hinweis">
   443	            <b lang="en">Note after verification</b>
   444	            <span dangerouslySetInnerHTML={html(inline(hinweis, gespraech))} />

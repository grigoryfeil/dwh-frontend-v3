    41	const MARKE = /^\s*\[(keine antwort|no answer|rückfrage|rueckfrage|clarification|kurzklärung|kurzklaerung|before building)\]\s*(.*)$/i;
    42	const HOST_ZEILE = /^[ \t>`]*(genui|visualize)\s*(?=\{)/gm;
    43	const BEKANNT = ["charts_widget_v2", "sources", "alternative_reading", "assumptions"];
    44	const objekt = (w: unknown): w is Record<string, unknown> => !!w && typeof w === "object" && !Array.isArray(w);
    45	const LEERER_CODEBLOCK = /^[ \t]*```[\w-]*[ \t]*\n(?:[ \t]*\n)*[ \t]*```[ \t]*$/gm;

   623	    def abbrechen(request):
   624	        s = hole_session(request)
   625	        if s is None:
   626	            return nicht_angemeldet()
   627	        marke = object()
   628	        with sperre:
   629	            eintrag = eigenes(request, s)
   630	            if eintrag is None:
   631	                return fehler(404, "Gespräch unbekannt")
   632	            if not eintrag.laeuft:
   633	                return fehler(409, "Im Gespräch läuft keine Frage")
   634	            eintrag.abbruch = marke
   635	        try:
   636	            if eintrag.pruefer is not None and eintrag.pruefer.thread_id:
   637	                eintrag.pruefer.unterbrechen()
   638	            elif eintrag.gespraech is not None and eintrag.gespraech.thread_id:
   639	                eintrag.gespraech.unterbrechen()
   640	        except (OSError, ValueError):
   641	            pass
   642	
   643	        def notbremse():
   644	            with sperre:
   645	                haengt = eintrag.laeuft and eintrag.abbruch is marke
   646	            if haengt:
   647	                eintrag.schliessen()
   648	
   649	        zeitgeber = threading.Timer(e.abbruch_frist, notbremse)
   650	        zeitgeber.daemon = True
   651	        zeitgeber.start()
   652	        return JSONResponse({"gespraech": eintrag.kennung}, status_code=202)

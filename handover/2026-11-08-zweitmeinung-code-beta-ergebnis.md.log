    25	// Runde Achsenwerte: Schrittweite 1, 2 oder 5 mal Zehnerpotenz. Balken beginnen bei null, Linien und Streuung nicht.
    26	function skala(werte: number[], mitNull = true, schritte = 4) {
    27	  let min = Math.min(...(mitNull ? [0] : []), ...werte);
    28	  let max = Math.max(...(mitNull ? [0] : []), ...werte);
    29	  if (min === max) [min, max] = [min - 1, max + 1];
    30	  const roh = (max - min || 1) / schritte;
    31	  const potenz = 10 ** Math.floor(Math.log10(roh));
    32	  const schritt = [1, 2, 5, 10].map((f) => f * potenz).find((s) => s >= roh) ?? roh;
    33	  const unten = Math.floor(min / schritt) * schritt;
    34	  const oben = Math.max(Math.ceil(max / schritt) * schritt, unten + schritt);
    35	  const ticks: number[] = [];
    36	  for (let t = unten; t <= oben + schritt / 2; t += schritt) ticks.push(Number(t.toPrecision(12)));
    37	  return { unten, oben, ticks };
    38	}
    39	
    40	const kurz = (t: string, n: number) => (t.length > n ? `${t.slice(0, n - 1)}…` : t);
    41	
    42	export function DiagrammAnsicht(props: { spec: Spec; lang: string }) {
    43	  const s = props.spec;
    44	  const daten = Array.isArray(s.data) ? s.data.slice(0, 200) : [];
    45	  const reihen = (Array.isArray(s.series) ? s.series : []).filter((r) => r && typeof r.dataKey === "string");
    46	  const titel = text(s.meta?.title);
    47	  const beschreibung = text(s.meta?.description);
    48	  const fuss = text(s.meta?.footer);
    49	  let svg: ReactElement | null = null;
    50	  if (s.chartType === "pie") svg = <Ring spec={s} daten={daten} lang={props.lang} />;
    51	  else if (reihen.length && (s.xKey || s.chartType === "scatter")) {
    52	    if (s.chartType === "line") svg = <Linien spec={s} daten={daten} reihen={reihen} lang={props.lang} />;
    53	    else if (s.chartType === "scatter") svg = <Streuung spec={s} daten={daten} reihen={reihen} lang={props.lang} />;
    54	    else if (s.layout === "vertical") svg = <Liegend spec={s} daten={daten} reihen={reihen} lang={props.lang} />;
    55	    else svg = <Stehend spec={s} daten={daten} reihen={reihen} lang={props.lang} />;
    56	  }
    57	  // Ein Diagramm, das sich nicht zeichnen lässt, verschwindet nicht still (Zweitmeinung 6.3)
    58	  if (!svg || !daten.length) return <div className="meta">A chart in this answer could not be displayed{titel ? `: ${titel}` : ""}.</div>;
    59	  return (
    60	    <figure className="diagramm" aria-label={titel || undefined}>
    61	      {(titel || beschreibung) && (
    62	        <figcaption>
    63	          {titel && <b>{titel}</b>}
    64	          {beschreibung && <span>{beschreibung}</span>}
    65	        </figcaption>
    66	      )}
    67	      {reihen.length > 1 && s.chartType !== "pie" && s.chartType !== "scatter" && (
    68	        <div className="legende">
    69	          {reihen.map((r, i) => (
    70	            <span key={r.dataKey}>
    71	              <i style={{ background: FARBEN[i % FARBEN.length] }} />
    72	              {text(r.label) || r.dataKey}
    73	            </span>
    74	          ))}
    75	        </div>
    76	      )}
    77	      {svg}
    78	      {fuss && <span className="diagramm-fuss">{fuss}</span>}
    79	    </figure>
    80	  );
    81	}

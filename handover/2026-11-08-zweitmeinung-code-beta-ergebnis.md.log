     1	// Vorgeladen in jeden Node-Prozess der Modell-Shell (NODE_OPTIONS über shell_environment_policy in codex-config.toml).
     2	// Die Sandbox verbietet die Socketpaare, die Node für eine Eingabe-Pipe anlegt: spawnSync ohne eigene stdio-Angabe
     3	// scheitert mit EPERM, unter anderem im Build der Data App des Plugins. Ohne Eingabe wird stdin deshalb ignoriert,
     4	// eine Eingabe läuft über eine Datei. Ausgabe und Fehlerausgabe bleiben Pipes, die die Sandbox erlaubt.
     5	// Befund: Lauf 20261108-172458, alle fünf Dashboard-Gespräche, jedes Modell baute dafür einen eigenen Umweg.
     6	"use strict";
     7	const cp = require("node:child_process");
     8	const fs = require("node:fs");
     9	const os = require("node:os");
    10	const path = require("node:path");
    11	
    12	const original = cp.spawnSync;
    13	cp.spawnSync = function spawnSync(befehl, args, optionen) {
    14	  if (!Array.isArray(args) && args && typeof args === "object") {
    15	    optionen = args;
    16	    args = [];
    17	  }
    18	  optionen = optionen || {};
    19	  if (optionen.stdio !== undefined) return original.call(this, befehl, args, optionen);
    20	  const { input, ...rest } = optionen;
    21	  let eingabe = "ignore";
    22	  let ordner = null;
    23	  if (input !== undefined) {
    24	    ordner = fs.mkdtempSync(path.join(os.tmpdir(), "spawn-"));
    25	    const datei = path.join(ordner, "stdin");
    26	    fs.writeFileSync(datei, input);
    27	    eingabe = fs.openSync(datei, "r");
    28	  }
    29	  try {
    30	    return original.call(this, befehl, args, { ...rest, stdio: [eingabe, "pipe", "pipe"] });
    31	  } finally {
    32	    if (typeof eingabe === "number") fs.closeSync(eingabe);
    33	    if (ordner) fs.rmSync(ordner, { recursive: true, force: true });
    34	  }
    35	};
    36	require("node:module").syncBuiltinESMExports();


   452	        {dashboards.map((d) => (
   453	          <DashboardKarte
   454	            key={d.url}
   455	            datei={d}
   456	            titel={titel[d.url] ?? titelAusName(d.name)}
   457	            onTitel={(t) => setTitel((alt) => ({ ...alt, [d.url]: t }))}
   458	            onOeffnen={() => props.onDashboard({ url: d.url, titel: titel[d.url] ?? titelAusName(d.name), nr: props.n, zeit: zug.fertig })}
   459	          />
   460	        ))}
{
  "name": "dwh-frontend-v2-oberflaeche",
  "private": true,
  "version": "0.18.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",

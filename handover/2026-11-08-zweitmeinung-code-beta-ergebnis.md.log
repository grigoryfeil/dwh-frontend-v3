     1	#!/bin/bash
     2	# Einrichtung von DWH Frontend V3 auf dem VPS, als root, wiederholbar.
     3	# Aufruf: betrieb/einrichtung.sh <Pfad zum entpackten Repo-Stand auf dem VPS>
     4	set -euo pipefail
     5	quelle="${1:?Repo-Stand fehlt}"
     6	V2=/opt/dwh-frontend-v2
     7	APP=/opt/dwh-frontend-v3/app
     8	H=/var/lib/dwh-frontend-v3/codex-home
     9	
    10	# V2 einfrieren: nichts mehr starten, der Login geht an V3 über (zwei Kopien entwerten sich gegenseitig).
    11	systemctl disable --now dwh-frontend-v2-web.service dwh-frontend-v2-codex.socket \
    12	  dwh-frontend-v2-codex-aktualisieren.timer dwh-frontend-v2-lesekonto.timer 2>/dev/null || true
    13	
    14	id dwhv3 &>/dev/null || useradd --system --home-dir /var/lib/dwh-frontend-v3 --shell /usr/sbin/nologin --user-group dwhv3
    15	install -d -m 0755 -o root -g root /opt/dwh-frontend-v3 /opt/dwh-frontend-v3/codex
    16	install -d -m 0750 -o dwhv3 -g dwhv3 /var/lib/dwh-frontend-v3 "$H" /var/lib/dwh-frontend-v3/gespraeche
    17	install -d -m 0700 -o root -g root /var/lib/dwh-frontend-v3/laeufe
    18	install -d -m 0750 -o root -g dwhv3 /etc/dwh-frontend-v3
    19	
    20	# Codex und Node: dieselben geprüften Versionen wie in V2, als eigene Kopie.
    21	ver=$(readlink "$V2/codex/aktuell")
    22	[[ -d /opt/dwh-frontend-v3/codex/$ver ]] || cp -a "$V2/codex/$ver" /opt/dwh-frontend-v3/codex/
    23	ln -sfn "$ver" /opt/dwh-frontend-v3/codex/aktuell

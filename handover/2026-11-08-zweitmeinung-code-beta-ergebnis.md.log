     1	"""Dateien, die das Modell im eigenen Gesprächsverzeichnis ablegt und in der Antwort nennt, etwa Diagramme.
     2	
     3	Das Modell verweist mit absolutem Pfad (`/var/lib/dwh-frontend-v3/gespraeche/web-<id>/bild.png`) oder relativ
     4	(`bild.png`) darauf. Solche Verweise werden in den Vertrag der Oberfläche übersetzt
     5	(`/api/gespraeche/<id>/dateien/<name>`) und als `dateien` der Runde gemeldet. Nur gemeldete Dateien werden
     6	ausgeliefert, nur reguläre Dateien innerhalb des Verzeichnisses, ohne Symlinks: Bilder, Tabellen und Dashboards.
     7	Andere Pfade bleiben Text.
     8	
     9	Dashboards (Data App des Data-Plugins) sind eigenständiges HTML mit Skript und eingebetteten Daten. Sie laufen nur im
    10	Rahmen der eigenen Seite (`Sec-Fetch-Dest: iframe`, `frame-ancestors 'self'`) in einer Sandbox mit fremdem Ursprung,
    11	ohne Netz (kein `connect-src`), ohne Formulare und Navigation. Als eigene Seite aufgerufen kommen sie als Quelltext,
    12	der nichts ausführt; so liest die Oberfläche auch den Titel. SVG bleibt draußen, es trüge Skript in ein `<img>`.
    13	"""
    14	
    15	import os
    16	import re
    17	import stat
    18	from urllib.parse import quote, unquote
    19	
    20	ARTEN = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "gif": "image/gif", "webp": "image/webp",
    21	         "csv": "text/csv", "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    22	         "html": "text/html; charset=utf-8", "htm": "text/html; charset=utf-8"}
    23	BILD = {"png", "jpg", "jpeg", "gif", "webp"}
    24	HTML = {"html", "htm"}
    25	NAME = re.compile(r"[\w][\w.\- ]{0,200}(?:/[\w][\w.\- ]{0,200}){0,4}")
    26	KOEPFE = {"Content-Security-Policy": "default-src 'none'; sandbox", "X-Content-Type-Options": "nosniff"}
    27	# data: in script-src, weil die Laufzeit der Data App als <script src="data:..."> in der Datei steckt. Das ist kein
    28	# Netz und erlaubt nichts, was 'unsafe-inline' nicht schon erlaubt. Kein connect-src: Nachladen bleibt gesperrt.
    29	DASHBOARD_CSP = ("sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline' data:; style-src 'unsafe-inline'; "
    30	                 "img-src data: blob:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'")
    31	# Knöpfe der Data App, die nur in ChatGPT funktionieren (Veröffentlichen, Fragen, Bearbeiten, Menü), wie in V2
    32	AUSBLENDEN = (b"<style>.dashboard-publish-button,.dashboard-publish-confirm,.publish-review-dialog,.dashboard-ask-anchor,"
    33	              b".dashboard-ask-button,.dashboard-ask-panel,.dashboard-header-edit-button,"
    34	              b".dashboard-header-overflow-button{display:none!important}</style>")
    35	ANKER = [re.compile(rb"<" + tag + rb"\b[^>]{0,1000}>", re.I) for tag in (rb"head", rb"html", rb"!doctype")]
    36	
    37	
    38	def auslieferung(name, inhalt, ziel):
    39	    """Inhalt, Medientyp und Köpfe für eine gemeldete Datei. `ziel` ist Sec-Fetch-Dest der Anfrage."""
    40	    endung = name.rsplit(".", 1)[-1].lower()
    41	    if endung in HTML:
    42	        koepfe = {"Content-Security-Policy": DASHBOARD_CSP, "X-Content-Type-Options": "nosniff",
    43	                  "Content-Disposition": "inline"}
    44	        if ziel != "iframe":
    45	            return inhalt, "text/plain; charset=utf-8", koepfe
    46	        for anker in ANKER:  # hinter <head>, sonst <html> oder den Doctype, davor fiele es in den Quirks-Modus
    47	            if treffer := anker.search(inhalt):
    48	                return inhalt[:treffer.end()] + AUSBLENDEN + inhalt[treffer.end():], ARTEN[endung], koepfe
    49	        return AUSBLENDEN + inhalt, ARTEN[endung], koepfe
    50	    art = "inline" if endung in BILD else f"attachment; filename=\"{quote(name.split('/')[-1])}\""
    51	    return inhalt, ARTEN[endung], {**KOEPFE, "Content-Disposition": art}
    52	
    53	
    54	def oeffne(cwd, name):
    55	    """Öffnet cwd/name Teil für Teil ohne Symlinks zu folgen, None wenn es keine reguläre Datei ist."""
    56	    try:
    57	        fd = os.open(cwd, os.O_RDONLY | os.O_DIRECTORY)
    58	    except OSError:
    59	        return None
    60	    try:
    61	        teile = name.split("/")
    62	        for teil in teile[:-1]:
    63	            neu = os.open(teil, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
    64	            os.close(fd)
    65	            fd = neu
    66	        datei = os.open(teile[-1], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    67	    except OSError:
    68	        return None
    69	    finally:
    70	        os.close(fd)
    71	    if not stat.S_ISREG(os.fstat(datei).st_mode):
    72	        os.close(datei)
    73	        return None
    74	    return os.fdopen(datei, "rb")
    75	
    76	
    77	def gueltig(cwd, name):
    78	    if not NAME.fullmatch(name) or ".." in name or name.rsplit(".", 1)[-1].lower() not in ARTEN:
    79	        return False
    80	    datei = oeffne(cwd, name)
    81	    if datei is None:
    82	        return False
    83	    datei.close()
    84	    return True
    85	
    86	
    87	def uebersetze(text, cwd, kennung):
    88	    """Antworttext mit übersetzten Verweisen und die Liste der Dateien [{name, url}] in Reihenfolge."""
    89	    basis = str(cwd).rstrip("/")
    90	    gefunden = {}
    91	
    92	    def url(name):
    93	        gefunden.setdefault(name, f"/api/gespraeche/{kennung}/dateien/{quote(name)}")
    94	        return gefunden[name]
    95	
    96	    def absolut(m):
    97	        name = unquote(m.group(1))
    98	        return url(name) if gueltig(cwd, name) else m.group(0)
    99	
   100	    # absolute Pfade überall im Text, auch mit file://
   101	    text = re.sub(r"(?:file://)?" + re.escape(basis) + r"/([^\s)\]\"'<>`]+)", absolut, text)
   102	
   103	    def relativ(m):
   104	        ziel = unquote(m.group(2).removeprefix("./"))
   105	        if re.match(r"^[a-z][a-z0-9+.-]*:|^/|^#", m.group(2), re.I) or not gueltig(cwd, ziel):
   106	            return m.group(0)
   107	        return f"{m.group(1)}({url(ziel)}{m.group(3) or ''})"
   108	
   109	    # relative Ziele in Markdown-Links und -Bildern: [text](bild.png) und ![text](bild.png "Titel")
   110	    text = re.sub(r"(\]\s*)\(\s*<?([^\s)<>]+)>?(\s+\"[^\"]*\")?\s*\)", relativ, text)
   111	    return text, [{"name": n, "url": u} for n, u in gefunden.items()]
     1	"""Konten der Oberfläche: je E-Mail ein scrypt-Hash, gepflegt von root, gelesen vom Backend.
     2	
     3	Kontendatei (JSON, root:dwhv3 0640): {"<email>": {"hash": "scrypt$n$r$p$salz$hash", "aktiv": true}}.
     4	Ein argon2-Hash (`$argon2id$...`) wird ebenfalls geprüft: So lässt sich ein Konto aus V2 samt Passwort übernehmen,
     5	ohne das Passwort zu kennen (Beta-Testkonto `tester`, 08.11.2026).
     6	Pflege auf dem VPS als root: `python3 -I /opt/dwh-frontend-v3/app/web/konten.py setzen <name> < passwortdatei`, `sperren <name>`.
     7	"""
     8	
     9	import hashlib
    10	import hmac
    11	import json
    12	import os
    13	import secrets
    14	import sys
    15	import threading
    16	from pathlib import Path
    17	
    18	N, R, P = 2**15, 8, 1
    19	SPEICHER = 64 * 1024 * 1024
    20	
    21	
    22	def normalisiere(email):
    23	    return (email or "").strip().lower()
    24	
    25	
    26	def hash_von(passwort, salz=None, n=N, r=R, p=P):
    27	    salz = salz or secrets.token_bytes(16)
    28	    wert = hashlib.scrypt(passwort.encode(), salt=salz, n=n, r=r, p=p, maxmem=SPEICHER, dklen=32)
    29	    return f"scrypt${n}${r}${p}${salz.hex()}${wert.hex()}"
    30	
    31	
    32	def stimmt(passwort, gespeichert):
    33	    if gespeichert.startswith("$argon2"):
    34	        try:
    35	            from argon2 import PasswordHasher  # nur für aus V2 übernommene Konten
    36	            return PasswordHasher().verify(gespeichert, passwort)
    37	        except Exception:  # noqa: BLE001, jede Abweichung heißt: stimmt nicht
    38	            return False
    39	    try:
    40	        _, n, r, p, salz, wert = gespeichert.split("$")
    41	        neu = hash_von(passwort, bytes.fromhex(salz), int(n), int(r), int(p))
    42	    except (ValueError, TypeError):
    43	        return False
    44	    return hmac.compare_digest(neu.rsplit("$", 1)[1], wert)
    45	
    46	
    47	class Konten:
    48	    """Liest die Kontendatei bei jeder Änderung neu, so wirken Sperren ohne Neustart."""
    49	
    50	    def __init__(self, pfad):
    51	        self.pfad = Path(pfad)
    52	        self._stand, self._konten = None, {}
    53	        self._sperre = threading.Lock()
    54	        self._attrappe = hash_von(secrets.token_urlsafe(16))
    55	
    56	    def _lade(self):
    57	        try:
    58	            merkmal = self.pfad.stat().st_mtime_ns
    59	        except OSError:
    60	            return {}
    61	        with self._sperre:
    62	            if merkmal != self._stand:
    63	                try:
    64	                    daten = json.loads(self.pfad.read_text(encoding="utf-8") or "{}")
    65	                except (OSError, ValueError):
    66	                    daten = {}
    67	                self._konten = daten if isinstance(daten, dict) else {}
    68	                self._stand = merkmal
    69	            return self._konten
    70	
    71	    def aktiv(self, email):
    72	        konto = self._lade().get(normalisiere(email))
    73	        return isinstance(konto, dict) and konto.get("aktiv", True) and isinstance(konto.get("hash"), str)
    74	
    75	    def pruefe(self, email, passwort):
    76	        konto = self._lade().get(normalisiere(email))
    77	        ok = stimmt(passwort, konto["hash"] if self.aktiv(email) else self._attrappe)
    78	        return ok and self.aktiv(email)
    79	
    80	
    81	def _schreibe(pfad, konten):
    82	    neu = Path(f"{pfad}.neu")
    83	    neu.write_text(json.dumps(konten, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    84	    try:
    85	        st = os.stat(pfad)
    86	        os.chown(neu, st.st_uid, st.st_gid)
    87	        os.chmod(neu, st.st_mode & 0o777)
    88	    except FileNotFoundError:
    89	        os.chmod(neu, 0o640)
    90	    os.replace(neu, pfad)
    91	
    92	
    93	def main(argv):
    94	    pfad = os.environ.get("DWH_V3_KONTEN", "/etc/dwh-frontend-v3/konten.json")
    95	    if len(argv) != 2 or argv[0] not in ("setzen", "sperren"):
    96	        sys.exit("Aufruf: python3 -I konten.py setzen|sperren <name>  (Passwort für setzen auf stdin)")
    97	    befehl, email = argv[0], normalisiere(argv[1])
    98	    try:
    99	        konten = json.loads(Path(pfad).read_text(encoding="utf-8") or "{}")
   100	    except FileNotFoundError:
   101	        konten = {}
   102	    if befehl == "setzen":
   103	        passwort = sys.stdin.readline().rstrip("\n")
   104	        if len(passwort) < 12:
   105	            sys.exit("Passwort zu kurz (mindestens 12 Zeichen)")
   106	        konten[email] = {"hash": hash_von(passwort), "aktiv": True}
   107	    else:
   108	        if email not in konten:
   109	            sys.exit("Konto unbekannt")
   110	        konten[email]["aktiv"] = False
   111	    _schreibe(pfad, konten)
   112	    print(f"{befehl}: {email}")
   113	
   114	
   115	if __name__ == "__main__":
   116	    main(sys.argv[1:])


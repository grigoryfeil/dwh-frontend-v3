     1	"""MCP-Server `dwh` mit genau einem Werkzeug: `sql`, lesend auf der DWH-Kopie.
     2	
     3	Codex startet ihn als Kindprozess außerhalb der Shell-Sandbox des Modells. Nur dieser Prozess liest die
     4	Optionsdatei des Lesekontos (`DWH_OPTIONSDATEI`) und erreicht den DB-Socket. Das Lesekonto darf nur SELECT.
     5	"""
     6	
     7	import configparser
     8	import datetime
     9	import decimal
    10	import json
    11	import os
    12	
    13	import pymysql
    14	
    15	ZEILEN_MAX = int(os.environ.get("DWH_ZEILEN_MAX", "1000"))
    16	OPTIONSDATEI = os.environ["DWH_OPTIONSDATEI"]
    17	
    18	
    19	def _schema():
    20	    optionen = configparser.ConfigParser(interpolation=None)
    21	    optionen.read(OPTIONSDATEI)
    22	    return optionen["client"]["database"]
    23	
    24	
    25	def _json_wert(wert):
    26	    if isinstance(wert, decimal.Decimal):
    27	        return str(wert)
    28	    if isinstance(wert, (datetime.date, datetime.datetime, datetime.time)):
    29	        return wert.isoformat()
    30	    if isinstance(wert, datetime.timedelta):
    31	        return str(wert)
    32	    if isinstance(wert, (bytes, bytearray)):
    33	        return wert.hex()
    34	    return wert
    35	
    36	
    37	def sql_ausfuehren(abfrage):
    38	    try:
    39	        verbindung = pymysql.connect(read_default_file=OPTIONSDATEI)
    40	    except pymysql.MySQLError as fehler:
    41	        return {"fehler": str(fehler)}
    42	    try:
    43	        with verbindung.cursor() as cursor:
    44	            cursor.execute(abfrage)
    45	            if cursor.description is None:
    46	                return {"spalten": [], "zeilen": [], "gekuerzt": False}
    47	            spalten = [b[0] for b in cursor.description]
    48	            zeilen = [[_json_wert(w) for w in z] for z in cursor.fetchmany(ZEILEN_MAX + 1)]
    49	        return {"spalten": spalten, "zeilen": zeilen[:ZEILEN_MAX], "gekuerzt": len(zeilen) > ZEILEN_MAX}
    50	    except pymysql.MySQLError as fehler:
    51	        return {"fehler": str(fehler)}
    52	    finally:
    53	        verbindung.close()
    54	
    55	
    56	def main():
    57	    from mcp.server.mcpserver import MCPServer
    58	    from mcp.types import ToolAnnotations
    59	
    60	    mcp = MCPServer("dwh")
    61	    beschreibung = (
    62	        f"Führt eine lesende SQL-Abfrage (MariaDB 10.6) auf der DWH-Kopie aus. Standardschema ist `{_schema()}`. "
    63	        f"Liefert JSON mit `spalten`, `zeilen` und `gekuerzt` (mehr als {ZEILEN_MAX} Zeilen) oder `fehler`. "
    64	        "Dezimalzahlen kommen als exakter Text."
    65	    )
    66	
    67	    @mcp.tool(description=beschreibung, annotations=ToolAnnotations(readOnlyHint=True))
    68	    def sql(abfrage: str) -> str:
    69	        return json.dumps(sql_ausfuehren(abfrage), ensure_ascii=False)
    70	
    71	    mcp.run()
    72	
    73	
    74	if __name__ == "__main__":
    75	    main()


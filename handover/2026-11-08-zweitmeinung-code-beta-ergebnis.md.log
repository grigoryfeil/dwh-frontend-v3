    93	def main(argv):
    94	    pfad = os.environ.get("DWH_V3_KONTEN", "/etc/dwh-frontend-v3/konten.json")
    95	    if len(argv) != 2 or argv[0] not in ("setzen", "sperren"):
    96	        sys.exit("Aufruf: python3 -I konten.py setzen|sperren <name>  (Passwort für setzen auf stdin)")
    97	    befehl, email = argv[0], normalisiere(argv[1])
    98	    try:
    99	        konten = json.loads(Path(pfad).read_text(encoding="utf-8") or "{}")
   100	    except FileNotFoundError:
   101	        konten = {}
   102	    if befehl == "setzen":
   103	        passwort = sys.stdin.readline().rstrip("\n")
   104	        if len(passwort) < 12:
   105	            sys.exit("Passwort zu kurz (mindestens 12 Zeichen)")
   106	        konten[email] = {"hash": hash_von(passwort), "aktiv": True}
   107	    else:
   108	        if email not in konten:
   109	            sys.exit("Konto unbekannt")
   110	        konten[email]["aktiv"] = False
   111	    _schreibe(pfad, konten)
   112	    print(f"{befehl}: {email}")

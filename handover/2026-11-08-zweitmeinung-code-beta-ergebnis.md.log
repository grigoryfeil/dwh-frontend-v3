    47	function jsonEnde(text: string, start: number): number | null {
    48	  let tiefe = 0;
    49	  let inText = false;
    50	  let maskiert = false;
    51	  for (let i = start; i < text.length; i++) {
    52	    const z = text[i];
    53	    if (inText) {
    54	      if (maskiert) maskiert = false;
    55	      else if (z === "\\") maskiert = true;
    56	      else if (z === '"') inText = false;
    57	    } else if (z === '"') inText = true;
    58	    else if (z === "{") tiefe++;
    59	    else if (z === "}" && --tiefe === 0) return i + 1;
    60	  }
    61	  return null;
    62	}
    63	
    64	export type HostTeil = { name: string; inhalt: unknown };
    65	
    66	// Text ohne Host-Zeilen und die Teile darin. Kaputtes JSON fällt aus dem Text, ab der Startzeile bis zu ihrem Ende, und
    67	// kommt wie visualize und unbekannte Namen als Teil "ungueltig", damit die Seite sagt, dass etwas fehlt.
    68	export function hostTeile(text: string): { text: string; teile: HostTeil[] } {
    69	  const teile: HostTeil[] = [];
    70	  const aus: string[] = [];
    71	  let pos = 0;
    72	  HOST_ZEILE.lastIndex = 0;
    73	  for (let t = HOST_ZEILE.exec(text); t; t = HOST_ZEILE.exec(text)) {
    74	    aus.push(text.slice(pos, t.index));
    75	    const klammer = t.index + t[0].length;
    76	    let ende = jsonEnde(text, klammer);
    77	    let wert: unknown = null;
    78	    try {
    79	      wert = ende ? JSON.parse(text.slice(klammer, ende)) : null;
    80	    } catch {
    81	      wert = null;
    82	    }
    83	    if (wert === null || ende === null) {
    84	      const nl = text.indexOf("\n", klammer);
    85	      ende = nl < 0 ? text.length : nl;
    86	    }
    87	    if (t[1] === "genui" && objekt(wert) && Object.keys(wert).length === 1) {
    88	      const [name, roh] = Object.entries(wert)[0];
    89	      const inhalt = objekt(roh) && "content" in roh ? roh.content : roh;
    90	      teile.push({ name: BEKANNT.includes(name) ? name : "ungueltig", inhalt });
    91	    } else teile.push({ name: "ungueltig", inhalt: null });
    92	    const zeilenende = text.indexOf("\n", ende);
    93	    const rest = text.slice(ende, zeilenende < 0 ? text.length : zeilenende);
    94	    pos = rest.replace(/[ \t`]/g, "") ? ende : zeilenende < 0 ? text.length : zeilenende;
    95	    HOST_ZEILE.lastIndex = pos;
    96	  }
    97	  aus.push(text.slice(pos));
    98	  return { text: aus.join("").replace(LEERER_CODEBLOCK, ""), teile };
    99	}

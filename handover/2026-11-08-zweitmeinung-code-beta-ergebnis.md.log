    99	class Drossel:
   100	    """Anmeldeversuche je Schlüssel: Eimer mit fünf Versuchen, einer kommt alle 36 Sekunden zurück."""
   101	
   102	    def __init__(self, kapazitaet=5, nachfuell_s=36.0):
   103	        self.kapazitaet, self.nachfuell_s = kapazitaet, nachfuell_s
   104	        self._eimer, self._sperre = {}, threading.Lock()
   105	
   106	    def verbrauche(self, schluessel):
   107	        with self._sperre:
   108	            jetzt = time.monotonic()
   109	            stand, zeit = self._eimer.get(schluessel, (self.kapazitaet, jetzt))
   110	            stand = min(self.kapazitaet, stand + (jetzt - zeit) / self.nachfuell_s)
   111	            if stand < 1:
   112	                return False, int((1 - stand) * self.nachfuell_s) + 1
   113	            if len(self._eimer) > 1024:
   114	                self._eimer.clear()
   115	            self._eimer[schluessel] = (stand - 1, jetzt)
   116	            return True, 0
   117	
   118	    def zuruecksetzen(self, schluessel):
   119	        with self._sperre:
   120	            self._eimer.pop(schluessel, None)

   639	                eintrag.gespraech.unterbrechen()
   640	        except (OSError, ValueError):
   641	            pass
   642	
   643	        def notbremse():
   644	            with sperre:
   645	                haengt = eintrag.laeuft and eintrag.abbruch is marke
   646	            if haengt:

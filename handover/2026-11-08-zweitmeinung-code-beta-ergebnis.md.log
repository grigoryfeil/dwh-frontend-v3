   348	// Sprache für Silbentrennung und lang-Attribut, Deutsch oder Englisch
   349	export function sprache(text: string): "de" | "en" {
   350	  const de = (text.match(/[äöüß]|\b(der|die|das|und|nicht|wie|welche|ist|sind|im|mit|für|seit|von|zu|den|dem)\b/gi) ?? []).length;
   351	  const en = (text.match(/\b(the|and|which|what|how|is|are|of|for|since|with|to|in)\b/gi) ?? []).length;
   352	  return de > en ? "de" : "en";
   353	}

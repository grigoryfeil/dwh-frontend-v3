    26	def hash_von(passwort, salz=None, n=N, r=R, p=P):
    27	    salz = salz or secrets.token_bytes(16)
    28	    wert = hashlib.scrypt(passwort.encode(), salt=salz, n=n, r=r, p=p, maxmem=SPEICHER, dklen=32)
    29	    return f"scrypt${n}${r}${p}${salz.hex()}${wert.hex()}"

    83	const werteAus = (daten: Record<string, unknown>[], reihen: Reihe[]) =>
    84	  daten.flatMap((d) => reihen.map((r) => zahl(d[r.dataKey]))).filter((w): w is number => w !== null);
    85	
    86	type Teil = { spec: Spec; daten: Record<string, unknown>[]; reihen: Reihe[]; lang: string };
    87	
    88	function Achse(props: { y: (w: number) => number; ticks: number[]; links: number; rechts: number; lang: string; reihe: Reihe }) {
    89	  return (
    90	    <g className="achse">
    91	      {props.ticks.map((t) => (
    92	        <g key={t}>
    93	          <line x1={props.links} x2={props.rechts} y1={props.y(t)} y2={props.y(t)} stroke={t === 0 || t === props.ticks[0] ? "#1c1c1c" : "#ededeb"} />
    94	          <text x={props.links - 8} y={props.y(t) + 4} textAnchor="end">{format(props.lang, t, props.reihe)}</text>
    95	        </g>
    96	      ))}
    97	    </g>
    98	  );
    99	}
   100	
   101	function Stehend({ spec, daten, reihen, lang }: Teil) {
   102	  const H = 300, L = 64, R = B - 8, O = 24, U = H - 44;
   103	  const werte = werteAus(daten, reihen);
   104	  if (!werte.length) return null;
   105	  const { unten, oben, ticks } = skala(werte);
   106	  const y = (w: number) => U - ((w - unten) / (oben - unten)) * (U - O);
   107	  const band = (R - L) / daten.length;
   108	  const gruppe = band * 0.72;
   109	  const breite = gruppe / reihen.length;
   110	  const jede = Math.ceil(daten.length / 12);
   111	  const mitWerten = daten.length * reihen.length <= 24;
   112	  return (
   113	    <svg viewBox={`0 0 ${B} ${H}`} role="img">
   114	      <Achse y={y} ticks={ticks} links={L} rechts={R} lang={lang} reihe={reihen[0]} />
   115	      {daten.map((d, i) => (
   116	        <g key={i}>
   117	          {reihen.map((r, k) => {
   118	            const w = zahl(d[r.dataKey]);
   119	            if (w === null) return null;
   120	            const x = L + i * band + (band - gruppe) / 2 + k * breite;
   121	            return (
   122	              <g key={r.dataKey}>
   123	                <rect x={x} y={Math.min(y(w), y(0))} width={Math.max(breite - 2, 1)} height={Math.abs(y(0) - y(w))}
   124	                  fill={FARBEN[k % FARBEN.length]}><title>{`${String(d[spec.xKey!] ?? "")}: ${format(lang, w, r)}`}</title></rect>
   125	                {mitWerten && <text className="wert" x={x + breite / 2 - 1} y={w >= 0 ? y(w) - 6 : y(w) + 14} textAnchor="middle">{format(lang, w, r)}</text>}
   126	              </g>
   127	            );
   128	          })}
   129	          {i % jede === 0 && (
   130	            <text className="kategorie" x={L + i * band + band / 2} y={U + 20} textAnchor="middle">
   131	              {kurz(String(d[spec.xKey!] ?? ""), Math.max(4, Math.floor(band * jede / 8)))}
   132	            </text>
   133	          )}
   134	        </g>
   135	      ))}
   136	      {spec.xAxisLabel && <text className="kategorie" x={(L + R) / 2} y={H - 4} textAnchor="middle">{spec.xAxisLabel}</text>}
   137	    </svg>
   138	  );
   139	}
   140	
   141	function Liegend({ spec, daten, reihen, lang }: Teil) {
   142	  const zeile = 14 + 12 * reihen.length, L = 184, R = B - 72, O = 8;
   143	  const H = O + zeile * daten.length + 8;
   144	  const werte = werteAus(daten, reihen);
   145	  if (!werte.length) return null;
   146	  const { unten, oben } = skala(werte);
   147	  const x = (w: number) => L + ((w - unten) / (oben - unten)) * (R - L);
   148	  return (
   149	    <svg viewBox={`0 0 ${B} ${H}`} role="img">
   150	      <line x1={x(0)} x2={x(0)} y1={O} y2={H - 8} stroke="#1c1c1c" />
   151	      {daten.map((d, i) => (
   152	        <g key={i}>
   153	          <text className="kategorie" x={L - 10} y={O + i * zeile + zeile / 2 + 4} textAnchor="end">{kurz(String(d[spec.xKey!] ?? ""), 26)}</text>
   154	          {reihen.map((r, k) => {
   155	            const w = zahl(d[r.dataKey]);
   156	            const yy = O + i * zeile + 7 + k * 12;
   157	            if (w === null) return <text key={r.dataKey} className="wert" x={x(0) + 6} y={yy + 9}>–</text>;
   158	            return (
   159	              <g key={r.dataKey}>
   160	                <rect x={Math.min(x(w), x(0))} y={yy} height={10} width={Math.max(Math.abs(x(w) - x(0)), 1)} fill={FARBEN[k % FARBEN.length]} />
   161	                <text className="wert" x={Math.max(x(w), x(0)) + 6} y={yy + 9}>{format(lang, w, r)}</text>
   162	              </g>
   163	            );
   164	          })}
   165	        </g>
   166	      ))}
   167	    </svg>
   168	  );
   169	}
   170	
   171	function Linien({ spec, daten, reihen, lang }: Teil) {
   172	  const H = 300, L = 64, R = B - 16, O = 24, U = H - 44, E = 32;
   173	  const werte = werteAus(daten, reihen);
   174	  if (!werte.length) return null;
   175	  const { unten, oben, ticks } = skala(werte, false);
   176	  const y = (w: number) => U - ((w - unten) / (oben - unten)) * (U - O);
   177	  const x = (i: number) => (daten.length === 1 ? (L + R) / 2 : L + E + (i / (daten.length - 1)) * (R - L - 2 * E));
   178	  const jede = Math.ceil(daten.length / 10);
   179	  const mitWerten = daten.length <= 12 && reihen.length === 1;
   180	  return (
   181	    <svg viewBox={`0 0 ${B} ${H}`} role="img">
   182	      <Achse y={y} ticks={ticks} links={L} rechts={R} lang={lang} reihe={reihen[0]} />
   183	      {reihen.map((r, k) => {
   184	        // Fehlende Werte unterbrechen die Linie
   185	        const stuecke: string[][] = [[]];
   186	        daten.forEach((d, i) => {
   187	          const w = zahl(d[r.dataKey]);
   188	          if (w === null) stuecke.push([]);
   189	          else stuecke[stuecke.length - 1].push(`${x(i)},${y(w)}`);
   190	        });
   191	        return (
   192	          <g key={r.dataKey}>
   193	            {stuecke.filter((p) => p.length > 1).map((p, j) => (
   194	              <polyline key={j} points={p.join(" ")} fill="none" stroke={FARBEN[k % FARBEN.length]} strokeWidth={2} />
   195	            ))}
   196	            {daten.map((d, i) => {
   197	              const w = zahl(d[r.dataKey]);
   198	              return w === null ? null : (
   199	                <g key={i}>
   200	                  <circle cx={x(i)} cy={y(w)} r={3} fill={FARBEN[k % FARBEN.length]}><title>{`${String(d[spec.xKey!] ?? "")}: ${format(lang, w, r)}`}</title></circle>
   201	                  {mitWerten && <text className="wert" x={x(i)} y={y(w) - 9} textAnchor="middle">{format(lang, w, r)}</text>}
   202	                </g>
   203	              );
   204	            })}
   205	          </g>
   206	        );
   207	      })}
   208	      {daten.map((d, i) => i % jede === 0 && (
   209	        <text key={i} className="kategorie" x={x(i)} y={U + 20} textAnchor="middle">{kurz(String(d[spec.xKey!] ?? ""), 12)}</text>
   210	      ))}
   211	    </svg>
   212	  );
   213	}
   214	
   215	function Streuung({ spec, daten, reihen, lang }: Teil) {
   216	  const H = 320, L = 64, R = B - 16, O = 16, U = H - 44;
   217	  const punkte = daten.map((d) => ({ x: zahl(d[spec.xKey ?? ""]), y: zahl(d[reihen[0].dataKey]) }))
   218	    .filter((p): p is { x: number; y: number } => p.x !== null && p.y !== null);
   219	  if (!punkte.length) return null;
   220	  const sx = skala(punkte.map((p) => p.x), false);
   221	  const sy = skala(punkte.map((p) => p.y), false);
   222	  const x = (w: number) => L + ((w - sx.unten) / (sx.oben - sx.unten)) * (R - L);
   223	  const y = (w: number) => U - ((w - sy.unten) / (sy.oben - sy.unten)) * (U - O);
   224	  return (
   225	    <svg viewBox={`0 0 ${B} ${H}`} role="img">
   226	      <Achse y={y} ticks={sy.ticks} links={L} rechts={R} lang={lang} reihe={reihen[0]} />
   227	      {sx.ticks.map((t) => <text key={t} className="kategorie" x={x(t)} y={U + 20} textAnchor="middle">{format(lang, t)}</text>)}
   228	      {punkte.map((p, i) => <circle key={i} cx={x(p.x)} cy={y(p.y)} r={4} fill="#1c1c1c" fillOpacity={0.7} />)}
   229	      {spec.xAxisLabel && <text className="kategorie" x={(L + R) / 2} y={H - 4} textAnchor="middle">{spec.xAxisLabel}</text>}
   230	    </svg>
   231	  );
   232	}
   233	
   234	function Ring({ spec, daten, lang }: { spec: Spec; daten: Record<string, unknown>[]; lang: string }) {
   235	  const name = spec.nameKey ?? spec.xKey ?? "";
   236	  const schluessel = spec.valueKey ?? spec.series?.[0]?.dataKey ?? "";
   237	  const teile = daten.map((d) => ({ name: String(d[name] ?? ""), w: zahl(d[schluessel]) ?? 0 })).filter((t) => t.w > 0);
   238	  const summe = teile.reduce((a, t) => a + t.w, 0);
   239	  if (!summe) return null;
   240	  const H = Math.max(200, 28 * teile.length + 24), M = 110, r = 90;
   241	  let winkel = -Math.PI / 2;
   242	  return (
   243	    <svg viewBox={`0 0 ${B} ${H}`} role="img">
   244	      {teile.map((t, i) => {
   245	        const anteil = t.w / summe;
   246	        const a0 = winkel;
   247	        winkel += anteil * 2 * Math.PI;
   248	        const gross = anteil > 0.5 ? 1 : 0;
   249	        const p = (a: number, rr: number) => `${M + rr * Math.cos(a)},${H / 2 + rr * Math.sin(a)}`;
   250	        const ri = r * 0.58;
   251	        const d = anteil >= 0.9999
   252	          ? `M ${p(0, r)} A ${r} ${r} 0 1 1 ${p(Math.PI, r)} A ${r} ${r} 0 1 1 ${p(0, r)} Z ` +
   253	            `M ${p(0, ri)} A ${ri} ${ri} 0 1 0 ${p(Math.PI, ri)} A ${ri} ${ri} 0 1 0 ${p(0, ri)} Z`
   254	          : `M ${p(a0, r)} A ${r} ${r} 0 ${gross} 1 ${p(winkel, r)} L ${p(winkel, r * 0.58)} A ${r * 0.58} ${r * 0.58} 0 ${gross} 0 ${p(a0, r * 0.58)} Z`;
   255	        return (
   256	          <g key={i}>
   257	            <path d={d} fillRule="evenodd" fill={FARBEN[i % FARBEN.length]} stroke="#fff" strokeWidth={1} />
   258	            <rect x={260} y={12 + i * 28} width={10} height={10} fill={FARBEN[i % FARBEN.length]} />
   259	            <text className="kategorie" x={280} y={21 + i * 28}>{kurz(t.name, 34)}</text>
   260	            <text className="wert" x={B - 8} y={21 + i * 28} textAnchor="end">
   261	              {`${format(lang, t.w, spec.series?.[0])} · ${format(lang, Math.round(anteil * 1000) / 10)} %`}
   262	            </text>
   263	          </g>
   264	        );
   265	      })}
   266	    </svg>
   267	  );
   268	}
   350	export function AntwortAbschnitt(props: { zug: Zug; n: number; arbeitet: boolean; onOption: (t: string) => void; onDashboard: (o: Overlay) => void }) {
   351	  const { zug } = props;
   352	  const text = zug.runde?.antwort ?? "";
   353	  const gespraech = zug.gespraech ?? null;
